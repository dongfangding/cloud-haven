<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 以 cloud-haven-parent 为 parent（relativePath 解析，${revision} 可插值）；
         cloud-haven-parent 再以具体版本继承 ddf-common-parent，版本与构建配置的单层来源 -->
    <parent>
        <groupId>io.github.dongfangding</groupId>
        <artifactId>cloud-haven-parent</artifactId>
        <version>${revision}</version>
        <relativePath>cloud-haven-parent/pom.xml</relativePath>
    </parent>

    <groupId>io.github.dongfangding</groupId>
    <artifactId>cloud-haven</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Spring Cloud骨架</name>
    <description>基于https://github.com/dongfangding/ddf-common作为Spring Boot脚手架，构建起来的Spring Cloud骨架
    </description>
    <url>https://github.com/dongfangding/cloud-haven</url>

    <!--
    spring-boot spring-cloud spring-cloud-alibaba 版本依赖关系
    https://github.com/alibaba/spring-cloud-alibaba/wiki/%E7%89%88%E6%9C%AC%E8%AF%B4%E6%98%8E
    推荐使用
    spring-cloud-alibaba    spring-cloud                spring-boot
    2025.0.0.0              2025.0.0                    3.5.x
    同时要注意的是安装的spring-cloud-alibaba的组件版本要对应上，关系如下，否则不保证可用
    Spring Cloud Alibaba Version	Sentinel Version	Nacos Version	RocketMQ Version	Seata Version
    2025.0.0.0                      1.8.9               3.0.3           5.3.1               2.5.0
    -->
    <properties>
        <maven.test.skip>true</maven.test.skip>
        <!-- 日常构建插件版本（编译插件版本、发布插件版本在 ddf-common-parent 统一维护） -->
        <!-- JUnit 5 requires Surefire version 2.22.0 or higher -->
        <maven.surefire.plugin.version>3.5.4</maven.surefire.plugin.version>
        <maven.source.plugin.version>3.2.1</maven.source.plugin.version>
        <ddf-common-dependency.version>boot3.5.16-2026.1.RELEASE</ddf-common-dependency.version>
    </properties>

    <!--维护依赖：对外导入统一走 cloud-haven-dependency 坐标，不直接暴露本 pom-->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.dongfangding</groupId>
                <artifactId>cloud-haven-dependency</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.dongfangding</groupId>
                <artifactId>ddf-common-dependency</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <modules>
        <module>cloud-haven-parent</module>
        <module>cloud-haven-dependency</module>
        <module>api</module>
        <module>core</module>
        <module>authentication</module>
        <module>gateway</module>
    </modules>


